rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Config & Secrets (Read-only for authenticated users, no public writes)
    match /config/secrets {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User Subscriptions (Strict User Ownership & Schema Validation)
    match /subscriptions/{documentId} {
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount >= 0;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User Profiles (Strict User Ownership)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Credit / Debit Cards (Strict User Ownership & Masked Last 4 Digits)
    match /cards/{documentId} {
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
