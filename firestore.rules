rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid is string
        && data.email is string
        && data.email.size() <= 254
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 80))
        && (!('photoURL' in data) || data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 500000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasOnlySubscriptionFields(data) {
      return data.keys().hasOnly([
        'userId', 'name', 'category', 'amount', 'currency', 'billingCycle',
        'renewalDate', 'status', 'pauseStartDate', 'pauseEndDate', 'autoResume',
        'reminderOffset', 'isFreeTrial', 'trialEndDate', 'contractEndDate',
        'notes', 'usageFrequency', 'lastUsedDate', 'usageScore', 'usageLogDates',
        'isTrial', 'hasContract', 'isPaused', 'cardId', 'assignedCardId',
        'isSplit', 'splitMembers', 'priceHistory', 'notificationId',
        'createdAt', 'updatedAt'
      ]);
    }

    function isValidSubscription(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 60
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 1000000000
        && data.currency is string
        && data.currency.matches('^[A-Z]{3}$')
        && data.billingCycle in [
          'weekly', 'monthly', 'quarterly', 'biannually', 'yearly', 'biennially'
        ]
        && data.renewalDate is timestamp
        && (!('status' in data) || data.status in ['active', 'paused'])
        && (!('notes' in data) || data.notes == null
          || (data.notes is string && data.notes.size() <= 1000))
        && (!('usageLogDates' in data) || data.usageLogDates is list
          && data.usageLogDates.size() <= 366)
        && (!('splitMembers' in data) || data.splitMembers is list
          && data.splitMembers.size() <= 20)
        && (!('priceHistory' in data) || data.priceHistory is list
          && data.priceHistory.size() <= 120)
        && data.updatedAt is timestamp;
    }

    function hasOnlyCardFields(data) {
      return data.keys().hasOnly([
        'userId', 'name', 'type', 'lastFourDigits', 'expiryMonth', 'expiryYear',
        'expiryDate', 'monthlyLimit', 'color', 'currency', 'isPinned',
        'createdAt', 'updatedAt'
      ]);
    }

    function isValidCard(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.type in ['visa', 'mastercard', 'troy', 'amex', 'other']
        && (!('lastFourDigits' in data) || data.lastFourDigits == null
          || (data.lastFourDigits is string && data.lastFourDigits.matches('^([0-9]{4})?$')))
        && data.expiryMonth is int
        && data.expiryMonth >= 1
        && data.expiryMonth <= 12
        && data.expiryYear is int
        && data.expiryYear >= 2000
        && data.expiryYear <= 2200
        && data.color is string
        && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.currency.matches('^[A-Z]{3}$')
        && (!('monthlyLimit' in data) || data.monthlyLimit == null
          || (data.monthlyLimit is number && data.monthlyLimit >= 0
            && data.monthlyLimit <= 1000000000))
        && data.updatedAt is timestamp;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Secrets are never readable from client applications. Server-side Cloud
    // Functions access Secret Manager instead of storing API keys in Firestore.
    match /config/secrets {
      allow read, write: if false;
    }

    // AI rate-limit counters are managed exclusively by the Admin SDK.
    match /_aiRateLimits/{documentId} {
      allow read, write: if false;
    }

    // User Subscriptions (Strict User Ownership & Schema Validation)
    match /subscriptions/{documentId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && hasOnlySubscriptionFields(request.resource.data)
        && isValidSubscription(request.resource.data)
        && request.resource.data.createdAt is timestamp;

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'amount', 'currency', 'billingCycle', 'renewalDate',
          'status', 'pauseStartDate', 'pauseEndDate', 'autoResume', 'reminderOffset',
          'isFreeTrial', 'trialEndDate', 'contractEndDate', 'notes',
          'usageFrequency', 'lastUsedDate', 'usageScore', 'usageLogDates', 'isTrial',
          'hasContract', 'isPaused', 'cardId', 'assignedCardId', 'isSplit',
          'splitMembers', 'priceHistory', 'notificationId', 'updatedAt'
        ])
        && isValidSubscription(request.resource.data);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User Profiles (Strict User Ownership)
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isValidUserProfile(request.resource.data, userId);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Credit / Debit Cards (Strict User Ownership & Masked Last 4 Digits)
    match /cards/{documentId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && hasOnlyCardFields(request.resource.data)
        && isValidCard(request.resource.data)
        && request.resource.data.createdAt is timestamp;

      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'type', 'lastFourDigits', 'expiryMonth', 'expiryYear',
          'expiryDate', 'monthlyLimit', 'color', 'currency', 'isPinned', 'updatedAt'
        ])
        && isValidCard(request.resource.data);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
