{
  "expo": {
    "name": "SubMate",
    "slug": "submate",
    "version": "1.5.1",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "submate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.doganaslan.submate",
      "buildNumber": "6",
      "icon": "./assets/images/logo.png",
      "jsEngine": "hermes"
    },
    "android": {
      "package": "com.doganaslan.submate",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/images/logo.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#3B82F6"
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SubMate, finansal verilerinizi güvenle açmak için Face ID kullanır."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SummaryWidget",
              "label": "SubMate Özet",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Aylık toplam ve sıradaki ödeme",
              "previewImage": "./assets/images/logo.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "googleServicesFile": "process.env.GOOGLE_SERVICES_JSON",
          "iosGoogleServicesFile": "process.env.GOOGLE_SERVICES_PLIST"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5e9ad797-f421-40c3-af7c-55cc66564254"
      }
    },
    "owner": "doganaslan"
  }
}
