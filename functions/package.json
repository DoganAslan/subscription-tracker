    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@google-cloud/storage": {
      "gaxios": "7.3.1",
      "retry-request": "8.0.4",
      "teeny-request": "10.1.4"
    }
  }
}
